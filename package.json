{
  "name": "@muyichengshayu/promptx",
  "version": "0.2.19",
  "description": "PromptX 本机 AI 协作工作台",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "promptx": "./bin/promptx.js"
  },
  "files": [
    "bin",
    "apps/daemon/src",
    "!apps/daemon/src/**/*.test.js",
    "apps/web/dist",
    "packages/shared/src",
    "!packages/shared/src/**/*.test.js",
    "packages/protocol/src",
    "!packages/protocol/src/**/*.test.js",
    "packages/relay/src",
    "!packages/relay/src/**/*.test.js",
    "scripts/doctor.mjs",
    "scripts/relay.mjs",
    "scripts/relay-service.mjs",
    "scripts/service.mjs",
    "scripts/lib/promptxPaths.mjs",
    "README.md",
    "CHANGELOG.md",
    "docs"
  ],
  "engines": {
    "node": ">=20.19.0 <21 || >=22.13.0 <23 || >=24 <25"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  },
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm -r build",
    "test": "pnpm --filter @promptx/shared test && pnpm --filter @promptx/relay test && pnpm --filter @promptx/protocol test && pnpm --filter @promptx/daemon test && pnpm --filter @promptx/web test",
    "start": "pnpm build && node scripts/service.mjs start",
    "stop": "node scripts/service.mjs stop",
    "restart": "pnpm stop && pnpm build && node scripts/service.mjs start",
    "status": "node scripts/service.mjs status",
    "doctor": "node scripts/doctor.mjs",
    "relay:start": "node scripts/relay.mjs",
    "deploy:relay:aliyun": "bash scripts/deploy-relay-aliyun.sh",
    "release:check": "node scripts/release.mjs check",
    "release:check:imports": "node scripts/check-package-runtime-imports.mjs",
    "release": "node scripts/release.mjs publish",
    "prepack": "pnpm build",
    "pack:dry": "npm pack --dry-run",
    "lint": "pnpm -r lint",
    "test:e2e": "pnpm --filter @promptx/web test:e2e"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.17.1",
    "@anthropic-ai/claude-agent-sdk": "0.3.246",
    "@fastify/cors": "11.2.0",
    "@fastify/multipart": "9.4.0",
    "@fastify/static": "9.0.0",
    "better-sqlite3": "12.8.0",
    "fastify": "5.8.2",
    "tweetnacl": "1.0.3",
    "ws": "8.18.3",
    "zod": "^4.4.3"
  }
}
